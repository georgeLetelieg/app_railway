# Copia este archivo como ".env" y completa los valores. NO subir ".env" a Git.
# Genera la clave con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion_flota
# Poner 1 solo cuando el sitio se sirva por HTTPS (producción)
SESSION_COOKIE_SECURE=0
# Poner 1 solo en desarrollo
FLASK_DEBUG=0
